# ─────────────────────────────────────────────────────────
# Copia este archivo a .env y ajusta los valores
# cp .env.example .env
# ─────────────────────────────────────────────────────────

# Tamaños de entrada para el benchmark (separados por coma, sin espacios).
# Con estos valores tarda ~1 minuto. Agregar 10000000 sube el tiempo a varios
# minutos y necesita ~2 GB de RAM; no se recomienda 100000000 (no cabe en memoria).
BENCHMARK_SIZES=10,100,1000,10000,100000,1000000

# Muestras por operación: cada operación se mide sola esta cantidad de veces
# y se reporta la MEDIANA (descarta picos del recolector de basura o del SO).
BENCHMARK_SAMPLES=15

# Nivel de log: INFO | WARNING | FINE | SEVERE
LOG_LEVEL=INFO
